# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/gaonwala
# OR for MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/gaonwala_db?retryWrites=true&w=majority

# Server Port
PORT=5000

# JWT Secret (Use a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Admin Credentials (for first-time setup)
ADMIN_EMAIL=admin@gaonwala.com
ADMIN_PASSWORD=your_secure_admin_password

# Google Gemini API (for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Credentials
# Get these from: https://dashboard.razorpay.com/
# For testing, use 'rzp_test_*' keys
# For production, use 'rzp_live_*' keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
