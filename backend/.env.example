# MongoDB Connection
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/gaonwala_db?retryWrites=true&w=majority

# Server Port
PORT=5000

# JWT Secret (use a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Admin Credentials

ADMIN_EMAIL=admin@gaonwala.com
ADMIN_PASSWORD=your_secure_admin_password

# Groq API (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Razorpay (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Twilio Notifications (https://console.twilio.com) ──────────────────────
# Account SID and Auth Token from Twilio Console dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# WhatsApp — Twilio Sandbox number (testing)
# For production: replace with your approved WhatsApp Business number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SMS — Your Twilio phone number (e.g. +12015551234)
TWILIO_SMS_FROM=+1xxxxxxxxxx
